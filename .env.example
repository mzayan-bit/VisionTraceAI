# ============================================================
# VisionTraceAI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ──────────────────── Project ────────────────────
PROJECT_NAME=VisionTraceAI

# ──────────────────── Qdrant Vector Database ────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ──────────────────── Compute Device ────────────────────
DEVICE=cpu                            # cpu | cuda | mps

# ──────────────────── AI Models ────────────────────
YOLO_MODEL=yolov8n.pt
SIGLIP_MODEL=google/siglip-base-patch16-224

# ──────────────────── Application ────────────────────
APP_NAME=VisionTraceAI
APP_ENV=development                   # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ──────────────────── Server ────────────────────
HOST=0.0.0.0
PORT=8000

# ──────────────────── Database ────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/visiontrace
REDIS_URL=redis://localhost:6379/0

# ──────────────────── Model Inference ────────────────────
MODEL_WEIGHTS_DIR=./weights
DETECTION_CONFIDENCE_THRESHOLD=0.5
TRACKING_MAX_AGE=30

# ──────────────────── Video / Stream ────────────────────
VIDEO_INPUT_DIR=./data/videos
VIDEO_OUTPUT_DIR=./data/outputs
RTSP_STREAM_URL=

# ──────────────────── Storage ────────────────────
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ──────────────────── Authentication ────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ──────────────────── External Services ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ──────────────────── Docker ────────────────────
COMPOSE_PROJECT_NAME=visiontrace
